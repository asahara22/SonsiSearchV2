# Search provider endpoint; response must be { "results": [{ "title", "url", "description" }] }
SEARCH_API_URL=
SEARCH_API_KEY=

# Public Halcyon origin; configure a real HTTPS URL after Render deployment.
NEXT_PUBLIC_PROXY_URL=

# Convex deployment URL from `npx convex dev` / the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=
